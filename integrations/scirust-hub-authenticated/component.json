{
  "schema_version": 1,
  "id": "2b0d1119-b405-4c70-9c5a-dd8535800a3d",
  "name": "SciRust-Verify Authenticated Inspector",
  "version": "0.1.0",
  "kind": "tool",
  "capabilities": [
    {
      "name": "verify.dossier_authenticity",
      "contract_version": "1.0.0",
      "inputs": [
        {
          "name": "dossier",
          "description": "application/vnd.scirust.verify-authenticated-transport.v1"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "description": "application/vnd.scirust.verify-hub-authenticated-inspection.v1+json"
        }
